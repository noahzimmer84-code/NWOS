<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NWOS.Host</RootNamespace>
    <OutputType>Exe</OutputType>
    <UserSecretsId>nwos-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NWOS.Contracts\NWOS.Contracts.csproj" />
    <ProjectReference Include="..\NWOS.Cardinal\NWOS.Cardinal.csproj" />
    <ProjectReference Include="..\NWOS.ConfigSetup\NWOS.ConfigSetup.csproj" />
    <ProjectReference Include="..\NWOS.Settings\NWOS.Settings.csproj" />
    <ProjectReference Include="..\NWOS.DesktopShell\NWOS.DesktopShell.csproj" />
    <ProjectReference Include="..\NWOS.Widgets\NWOS.Widgets.csproj" />
    <ProjectReference Include="..\NWOS.Alice\NWOS.Alice.csproj" />
    <ProjectReference Include="..\NWOS.Marc\NWOS.Marc.csproj" />
    <ProjectReference Include="..\NWOS.Alya\NWOS.Alya.csproj" />
    <ProjectReference Include="..\NWOS.SystemCenter\NWOS.SystemCenter.csproj" />
    <ProjectReference Include="..\NWOS.Ipc\NWOS.Ipc.csproj" />
    <!-- NWOS.SystemCenter.Windows und NWOS.WindowsIntegration bewusst NICHT
         hier referenziert: der Host bleibt dadurch plattformneutral testbar.
         Die echten Windows-Implementierungen (WMI, Registry, Shell-
         Registrierung) werden von NWOS.Bootstrap.Windows verdrahtet, das
         diesen Host über HostComposition.RunAsync(args, windowsExtensions)
         wiederverwendet. Ohne dieses Bootstrap-Projekt (z. B. direkter Start
         von NWOS.Host) läuft SystemCenterModule mit
         statusProvider/autostartManager = null - getestetes, transparentes
         Fallback-Verhalten statt Fake-Daten (siehe NWOS.SystemCenter.Tests).
         NWOS.Ipc dagegen IST plattformneutral (System.IO.Pipes) und wird
         deshalb hier direkt referenziert, nicht erst im Bootstrap-Projekt. -->
  </ItemGroup>

</Project>
